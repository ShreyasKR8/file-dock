<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <title>Sign Up</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <!-- <link rel="icon" href="/images/group.png"> -->
    <link rel="stylesheet" href="/css/styles.css">
</head>

<body>
    <main class="auth-page">
        <section class="auth-card compact">
            <div class="auth-header">
                <p class="eyebrow">Create access</p>
                <h1 class="page-title">Register</h1>
                <!-- <p class="page-copy">Make your account first, then unlock member status from inside the app.</p> -->
            </div>

            <form method="POST" action="register" id="register-form" novalidate
                data-server-errors="<%= encodeURIComponent(JSON.stringify((errors || []).map((error) => error.msg))) %>">
                <div class="form-grid two-column">
                    <div class="field">
                        <label for="firstname">First Name</label>
                        <input id="firstname" type="text" name="firstname" required value="<%= formData?.firstname || '' %>" />
                    </div>
                    <div class="field">
                        <label for="lastname">Last Name</label>
                        <input id="lastname" name="lastname" type="text" required value="<%= formData?.lastname || '' %>" />
                    </div>
                    <div class="field full-width">
                        <label for="username">User Name</label>
                        <input id="username" name="username" type="text" required value="<%= formData?.username || '' %>" />
                    </div>
                    <div class="field full-width">
                        <label for="email">Email</label>
                        <input id="email" name="email" type="email" required value="<%= formData?.email || '' %>" />
                    </div>
                    <div class="field full-width checkbox-field">
                        <label class="checkbox-row" for="admin">
                            <input type="checkbox" id="admin" name="admin" value="yes" <%= formData?.admin ? 'checked' : '' %>>
                            <span>Become an Admin</span>
                        </label>
                    </div>
                    <div class="field">
                        <label for="password">Password</label>
                        <div class="password-input-wrap">
                            <input id="password" name="password" type="password" placeholder="Password" required />
                            <button type="button" class="password-toggle" aria-label="Show password" aria-pressed="false">
                                <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12Z" />
                                    <circle cx="12" cy="12" r="3" />
                                </svg>
                            </button>
                        </div>
                    </div>
                    <div class="field">
                        <label for="confirmpassword">Confirm Password</label>
                        <input id="confirmpassword" name="confirmpassword" type="password" required />
                    </div>
                </div>

                <div class="form-actions">
                    <button class="btn btn-primary" type="submit">Sign up</button>
                    <a class="btn btn-secondary" href="/">Back to home</a>
                </div>
            </form>
        </section>
    </main>
    <script src="/js/register-form.js"></script>
    <footer class="site-footer">
        <!-- <a href="https://www.flaticon.com/free-icons/members" target="_blank" title="members icons">Members icons created by Irfansusanto20 - Flaticon</a> -->
    </footer>
</body>

</html>
