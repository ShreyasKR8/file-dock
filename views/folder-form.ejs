<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <title>Create folder · FileDock</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="stylesheet" href="/css/styles.css">
</head>

<body>
    <%- include("partials/header") %>
    <main id="main-content" class="auth-page">
        <section class="panel">
            <p class="eyebrow">A place for everything</p><h1 class="page-title">New folder</h1><p class="page-copy">Keep related files together.</p>

            <form method="POST" action="/folders/create">
                <div class="field">
                    <label for="folder-name">Folder Name</label>
                    <input id="folder-name" type="text" name="name" placeholder="e.g. Project documents" required />
                </div>
                <div class="form-actions">
                    <button class="btn btn-primary" type="submit">Create</button>
                    <a class="btn btn-secondary" href="/">Back to home</a>
                </div>
            </form>
        </section>
    </main>
</body>
</html>
