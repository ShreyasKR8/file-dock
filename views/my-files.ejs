<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <title>FileDock</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="icon" href="/images/group.png">
    <link rel="stylesheet" href="/css/styles.css">
</head>

<body>
    <h1><%= title %></h1>
    <% if (locals.currentUser != null) { %>
        <form action="/files/upload" method="POST" enctype="multipart/form-data">
            <input type="file" name="file" required>
            <button type="submit">Upload</button>
        </form>
        <button type="button" id="create-folder-btn">Create new folder</button>
        <dialog id="create-folder-dialog" 
            data-has-errors="<%= locals.errors?.length > 0 %>"
        >
            <form action="/folders/create" method="POST">
                <h2>Create new folder</h2>

                <label for="folder-name">Folder name</label>
                <input
                    type="text"
                    id="folder-name"
                    name="name"
                    value="<%= locals.formData?.name ?? '' %>"
                    required
                >

                <% if (locals.errors) { %>
                    <div class="form-errors" role="alert">
                        <% locals.errors.forEach(error => { %>
                            <p><%= error.msg %></p>
                        <% }) %>
                    </div>
                <% } %>

                <button type="button" id="cancel-folder-btn">Cancel</button>
                <button type="submit">Create</button>
            </form>
        </dialog>
        <% folders.forEach(folder => { %>
            <div class="folder">
                <a href=""><%= folder.name %></a>
                <button type="button" class="edit-folder-btn">Edit</button>
                <dialog class="edit-folder-dialog"
                    data-has-errors="<%= locals.errors?.length > 0 %>"
                >
                    <form action="/folders/<%= folder.id %>?_method=PATCH" method="POST">
                        <h2>Edit Folder Name</h2>

                        <label for="folder-name">Folder name</label>
                        <input
                            type="text"
                            id="folder-name"
                            name="name"
                            value="<%= locals.formData?.name ?? '' %>"
                            required
                        >

                        <% if (locals.errors) { %>
                            <div class="form-errors" role="alert">
                                <% locals.errors.forEach(error => { %>
                                    <p><%= error.msg %></p>
                                <% }) %>
                            </div>
                        <% } %>

                        <button type="button" class="cancel-edit-folder-btn">Cancel</button>
                        <button type="submit">Rename</button>
                    </form>
                </dialog>
            </div>
        <% }); %>
    <% } %>
    <footer class="site-footer">
    </footer>
    <script src="/js/folders.js"></script>
</body>
</html>
