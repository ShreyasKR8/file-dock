<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <title>FileDock</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="icon" href="/images/icons8-cloud-storage-48.png">
    <link rel="stylesheet" href="/css/styles.css">
</head>

<body>
    <%- include("partials/header") %>
    <main id="main-content" class="page-shell">
    <div class="page-heading"><p class="eyebrow">Your workspace</p><h1 class="page-title"><%= title %></h1><p class="page-copy">Everything you need, right where you left it.</p></div>
    <% if (locals.currentUser != null) { %>
        <%- include("partials/file-upload-form", {
            folders,
            maxFileSize,
            showFolderSelect: true,
            currentFolderId: null,
            supabaseBucket
        }) %>
        <button type="button" id="create-folder-btn">Create new folder</button>
        <dialog id="create-folder-dialog" 
            data-has-errors="<%= locals.errors?.length > 0 %>"
        >
            <form action="/folders/create" method="POST">
                <h2>Create new folder</h2>

                <label for="folder-name">Folder name</label>
                <input
                    type="text"
                    id="folder-name"
                    name="name"
                    value="<%= locals.formData?.name ?? '' %>"
                    required
                >

                <% if (locals.errors?.length) { %>
                    <div class="form-errors" role="alert">
                        <% locals.errors.forEach(error => { %>
                            <p><%= error.msg %></p>
                        <% }) %>
                    </div>
                <% } %>

                <button type="button" id="cancel-folder-btn">Cancel</button>
                <button type="submit">Create</button>
            </form>
        </dialog>
        <section class="library"><div class="section-header"><h2 class="section-title">Files & folders</h2><span class="count-badge"><%= files.length + folders.length %> items</span></div>
        <div class="files-folders">
            <% if (files.length === 0 && folders.length === 0) { %>
                <div class="empty-state"><span class="empty-icon" aria-hidden="true">＋</span><h3>No files here yet</h3><p class="meta-text">Upload your first file to give it a home.</p></div>
            <% } %>
            <% files.forEach(file => { %>
                <div class="file">
                    <span class="item-kind">File</span><p class="item-name"><%= file.name %></p>
                    <a href="/files/<%= file.id %>">View Details</a>
                    <form action="/files/<%= file.id %>?_method=DELETE" method="POST">
                        <button type="submit">Delete</button>
                    </form>
                </div>
            <% }); %>
            <% folders.forEach(folder => { %>
                <div class="folder">
                    <span class="item-kind">Folder</span>
                    <a href="folders/<%= folder.id %>"><%= folder.name %></a>
                    <button type="button" class="edit-folder-btn">Edit</button>

                    <button type="button" class="share-folder-btn" 
                    data-folder-id="<%= folder.id %>">
                        Share
                    </button>

                    <dialog class="edit-folder-dialog"
                        data-has-errors="<%= locals.errors?.length > 0 %>"
                    >
                        <form action="/folders/<%= folder.id %>?_method=PATCH" method="POST">
                            <h2>Edit Folder Name</h2>
    
                            <label for="folder-name-<%= folder.id %>">Folder name</label>
                            <input
                                type="text"
                                id="folder-name-<%= folder.id %>"
                                name="name"
                                value="<%= locals.formData?.name ?? '' %>"
                                required
                            >
    
                            <% if (locals.errors?.length) { %>
                                <div class="form-errors" role="alert">
                                    <% locals.errors.forEach(error => { %>
                                        <p><%= error.msg %></p>
                                    <% }) %>
                                </div>
                            <% } %>
    
                            <button type="button" class="cancel-edit-folder-btn">Cancel</button>
                            <button type="submit">Rename</button>
                        </form>
                    </dialog>
                    <button type="button" class="delete-folder-btn">Delete</button>
                    <dialog class="delete-folder-dialog">
                        <form action="/folders/<%= folder.id %>?_method=DELETE" method="POST">
                            <h2>Delete Folder <%= folder.name %></h2>
                            <p>Are you sure?</p>
                            <button type="button" class="cancel-delete-folder-btn">Cancel</button>
                            <button type="submit">Delete</button>
                        </form>
                    </dialog>
                </div>
            <% }); %>
        </div>
        </section>
        <dialog class="share-dialog" data-has-errors="<%= locals.errors?.length > 0 %>">
            <h3>Share Folder</h3>
            <form class="share-folder-form" method="POST">
                <label for="validDuration">Link expires after</label>
                <select name="validDuration" id="validDuration">
                    <option value="1">1 day</option>
                    <option value="7">7 days</option>
                    <option value="30">30 days</option>
                </select>
        
                <% if (locals.errors?.length) { %>
                    <div class="form-errors" role="alert">
                        <% locals.errors.forEach(error=> { %>
                            <p>
                                <%= error.msg %>
                            </p>
                            <% }) %>
                    </div>
                <% } %>
        
                <button type="button" class="cancel-share-folder-btn">Cancel</button>
                <button type="submit">Generate Link</button>
            </form>
        </dialog>
        <dialog class="show-link-dialog">
            <h3>Copy generated link</h3>
            <p class="share-link"></p>
            <button type="button" class="close-show-link-btn">Close</button>
        </dialog>
    <% } %>
    </main>
    <%- include("partials/footer") %>
    <script src="/js/folders.js" defer></script>
</body>
</html>
