<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="icon" href="/images/icons8-cloud-storage-48.png">
    <link rel="stylesheet" href="/css/styles.css">
</head>
<body>
    <main>
        <div class="hero-actions">
        <% if (locals.currentUser == null) { %>
                <a class="btn btn-primary" href="/auth/register">Create an account</a>
                <a class="btn btn-secondary" href="/auth/login">Log In</a>
        <% } else { %>
            <a class="btn btn-secondary" href="/auth/logout">Logout</a>
        <% } %>
        </div>
        <h1><%= title %></h1>
        <p>Upload, organize, and access your files from one calm little dock.</p>
        <% if (locals.currentUser != null) { %>
            <h3>Browse your files: </h3>
            <a href="/files">MyFiles</a>
        <% } %>
    </main>
    <footer class="site-footer">
        <a target="_blank" href="https://icons8.com/icon/r8kHwiV6nVEd/cloud-storage">
            Cloud Storage
        </a> 
            icon by 
        <a target="_blank" href="https://icons8.com">Icons8</a>
    </footer>
</body>
</html>
