<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <title>FileDock</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="icon" href="/images/icons8-cloud-storage-48.png">
    <link rel="stylesheet" href="/css/styles.css">
</head>

<body>
    <% if (locals.currentUser != null) { %>
        <div class="file-details">
            <h1><%= file.name %></h1>
            <p>Type: <%= file.extension %></p>
            <p>Size: <%= file.size %></p>
            <p>Uploaded: <%= file.createdAt %></p>
            <a href="/files/<%= file.id %>/download">Download</a>
        </div>
    <% } %>
    <a href="/files">Go Back</a>
    <footer class="site-footer">
        <a target="_blank" href="https://icons8.com/icon/r8kHwiV6nVEd/cloud-storage">
            Cloud Storage
        </a> 
            icon by 
        <a target="_blank" href="https://icons8.com">Icons8</a>
    </footer>
</body>
</html>
