<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <title>FileDock</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="icon" href="/images/icons8-cloud-storage-48.png">
    <link rel="stylesheet" href="/css/styles.css">
</head>

<body>
    <%- include("partials/header") %>
    <main id="main-content" class="page-shell">
    <% if (locals.currentUser != null) { %>
        <div class="page-heading"><p class="eyebrow">Your workspace</p><h1 class="page-title">File details</h1></div>
        <div class="file-details">
            <span class="item-kind">File</span>
            <h2><%= file.name %></h2>
            <p>Type: <%= file.extension %></p>
            <p>Size: <%= file.size %></p>
            <p>Uploaded: <%= file.createdAt %></p>
            <a href="/files/<%= file.id %>/download">Download</a>
        </div>
    <% } %>
    <a class="btn btn-secondary back-link" href="/files">← Back to my files</a>
    </main>
    <%- include("partials/footer") %>
</body>
</html>
