<section class="upload-panel" aria-labelledby="upload-title">
<div class="upload-heading"><span class="upload-icon" aria-hidden="true">↑</span><div><h2 id="upload-title">Give your files a home</h2><p class="meta-text">Choose a file up to <%= Math.round(maxFileSize / (1024 * 1024)) %> MB.</p></div></div>
<form id="upload-form" data-folder-id="<%= currentFolderId ?? '' %>">
    <div class="field upload-file"><label for="file-input">Choose a file</label>
    <input type="file" id="file-input" 
        name="file" 
        data-max-file-size="<%= maxFileSize %>" 
        required>
    <div id="upload-progress" class="upload-progress" hidden>
        <progress id="upload-progress-bar" max="100" value="0" aria-label="File upload progress"></progress>
        <div class="upload-progress-details">
            <span id="upload-percentage">0%</span>
            <span id="upload-bytes">0.0 / 0.0 MB</span>
        </div>
    </div>
    <span id="upload-status" class="upload-status" role="status" aria-live="polite" aria-atomic="true"></span>
    </div>

    <% if(showFolderSelect) { %>
        <div class="field upload-destination"><label for="upload-folder">Save to</label>
        <select id="upload-folder" name="folderId" class="folder-select">
            <option value="">My files</option>
            <% folders.forEach(folder=> { %>
                <option value="<%= folder.id %>">
                    <%= folder.name %>
                </option>
                <% }) %>
        </select></div>
    <% } %>

    <% if (locals.uploadErrors?.length) { %>
        <div class="form-errors" role="alert">
            <% uploadErrors.forEach(error=> { %>
                <p>
                    <%= error.msg %>
                </p>
                <% }) %>
        </div>
    <% } %>

    <p id="upload-error" class="form-errors" role="alert" hidden></p>
    <button class="btn btn-primary" type="submit">Upload file ↑</button>
</form>
</section>

<script>
    window.SUPABASE_PROJECT_ID = <%- JSON.stringify(supabaseProjectId) %>;
    window.SUPABASE_BUCKET = <%- JSON.stringify(supabaseBucket) %>;

</script>
<script src="/js/files.js" defer></script>
<script src="/dist/file-upload.js" defer></script>
