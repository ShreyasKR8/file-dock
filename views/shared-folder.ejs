<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <title>FileDock</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="icon" href="/images/group.png">
    <link rel="stylesheet" href="/css/styles.css">
</head>

<body>
    <h1>
        <%= title %>
    </h1>
    <div class="files-folders">
        <% files.forEach(file=> { %>
        <div class="file-details">
            <h1><%= file.name %></h1>
            <p>Type: <%= file.extension %></p>
            <p>Size: <%= file.size %></p>
            <p>Uploaded: <%= file.createdAt %></p>
        </div>
        <% }); %>
    </div>
    <a href="/files">Go Back</a>
    <footer class="site-footer">
    </footer>
</body>

</html>