<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <title>FileDock</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="icon" href="/images/icons8-cloud-storage-48.png">
    <link rel="stylesheet" href="/css/styles.css">
</head>

<body>
    <%- include("partials/header") %>
    <main id="main-content" class="page-shell">
    <div class="page-heading"><p class="eyebrow">Shared with you</p><h1 class="page-title"><%= title %></h1><p class="page-copy">Browse and download the files in this shared folder.</p></div>
    <section class="library"><div class="section-header"><h2 class="section-title">Shared files</h2><span class="count-badge"><%= files.length %> items</span></div>
        <div class="files-folders">
            <% if (files.length === 0) { %>
                <div class="empty-state"><span class="empty-icon" aria-hidden="true">＋</span><h3>No files here yet</h3><p class="meta-text">Files will appear here when the owner adds them.</p></div>
            <% } %>
        <% files.forEach(file=> { %>
            <div class="file-details">
                <span class="item-kind">File</span><h3><%= file.name %></h3>
                <p>Type: <%= file.extension %></p>
                <p>Size: <%= file.size %></p>
                <p>Uploaded: <%= file.createdAt %></p>
                <a href="/shared/<%= token %>/files/<%= file.id %>/download">
                    Download
                </a>
            </div>
        <% }); %>
    </div>
    </section>
    </main>
    <%- include("partials/footer") %>
</body>

</html>